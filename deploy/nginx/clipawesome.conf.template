# ClipAwesome vhost — rendered by deploy/deploy.sh from deploy/nginx/clipawesome.conf.template
server {
    listen 80;
    server_name __SERVER_NAME__;

    # Local video uploads stream straight through to the app (up to the app's 20 GB cap).
    client_max_body_size 20g;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # A variable upstream is resolved per request, so nginx still starts while ClipAwesome is down.
    __RESOLVER__

    location / {
        set $clipawesome_upstream __PROXY_TARGET__;
        proxy_pass $clipawesome_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
