# Non-secret deployment settings. The pipeline copies this to .env on the server
# and appends CLIPAWESOME_AUTH_USER / CLIPAWESOME_AUTH_PASSWORD from GitHub secrets.
# For a manual run: copy to .env, set CLIPAWESOME_AUTH_PASSWORD, `docker compose up -d --build`.

# Image tag built and run by compose
CLIPAWESOME_IMAGE_TAG=prod
# Host port (bound to 127.0.0.1 only)
CLIPAWESOME_HOST_PORT=8096
# Include local Whisper transcription (true/false)
CLIPAWESOME_TRANSCRIBE=true
# Resource caps so this app can't starve others on the shared VM
CLIPAWESOME_MEM_LIMIT=3g
CLIPAWESOME_CPUS=2
# Never let web users analyse arbitrary server paths
CLIPAWESOME_ALLOW_LOCAL_PATH=false
